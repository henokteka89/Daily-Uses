 
/*
    Generates US Federal Holidays for a specified year.

    Includes:
        New Year's Day
        Martin Luther King Jr. Day
        Washington's Birthday (Presidents Day)
        Memorial Day
        Juneteenth
        Independence Day
        Labor Day
        Columbus Day
        Veterans Day
        Thanksgiving Day
        Christmas Day

    Weekend holidays are adjusted to observed dates:
        Saturday  -> Friday
        Sunday    -> Monday
For instance 2026 Independence day falls on Saturday July 04, but this will show July 03 Friday since it is observed the day before when it fall on weekend. 
The same for 2039 new year shows Dec 31, 2038 because it falls on Saturday.

*/

DECLARE @Year int = 2039;

DECLARE @PublicHolidays TABLE
(
      HolidayName varchar(100)
    , HolidayDate date
    , DayOfWeek varchar(20)
);

---------------------------------------------------------
-- New Year's Day
---------------------------------------------------------
DECLARE @Holiday date = DATEFROMPARTS(@Year,1,1);

IF DATENAME(WEEKDAY,@Holiday) = 'Saturday'
    SET @Holiday = DATEADD(DAY,-1,@Holiday);
ELSE IF DATENAME(WEEKDAY,@Holiday) = 'Sunday'
    SET @Holiday = DATEADD(DAY,1,@Holiday);

INSERT INTO @PublicHolidays
SELECT
      'New Year''s Day'
    , @Holiday
    , DATENAME(WEEKDAY,@Holiday);

---------------------------------------------------------
-- Martin Luther King Jr Day
-- Third Monday in January
---------------------------------------------------------
;WITH D AS
(
    SELECT DATEFROMPARTS(@Year,1,1) AS Dt
    UNION ALL
    SELECT DATEADD(DAY,1,Dt)
    FROM D
    WHERE MONTH(DATEADD(DAY,1,Dt)) = 1
)
INSERT INTO @PublicHolidays
SELECT TOP (1)
      'Martin Luther King Jr. Day'
    , Dt
    , DATENAME(WEEKDAY,Dt)
FROM
(
    SELECT
          Dt
        , ROW_NUMBER() OVER(ORDER BY Dt) AS RN
    FROM D
    WHERE DATENAME(WEEKDAY,Dt)='Monday'
) X
WHERE RN = 3
OPTION (MAXRECURSION 31);

