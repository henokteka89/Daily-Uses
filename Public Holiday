FROM
(
    SELECT
          Dt
        , ROW_NUMBER() OVER(ORDER BY Dt) AS RN
    FROM D
    WHERE DATENAME(WEEKDAY,Dt)='Monday'
) X
WHERE RN = 3
OPTION (MAXRECURSION 31);

---------------------------------------------------------
-- Memorial Day
-- Last Monday in May
---------------------------------------------------------
;WITH D AS
(
    SELECT DATEFROMPARTS(@Year,5,1) AS Dt
    UNION ALL
    SELECT DATEADD(DAY,1,Dt)
    FROM D
    WHERE MONTH(DATEADD(DAY,1,Dt)) = 5
)
INSERT INTO @PublicHolidays
SELECT TOP (1)
      'Memorial Day'
    , Dt
    , DATENAME(WEEKDAY,Dt)
FROM D
WHERE DATENAME(WEEKDAY,Dt)='Monday'
ORDER BY Dt DESC
OPTION (MAXRECURSION 31);

