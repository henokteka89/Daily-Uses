
DECLARE @Year char(4)
, @Date datetime
, @Holiday datetime

SET @Year = 2039

Declare @publicHolidays table (Holiday nvarchar(70), Date Datetime, DayofWeek nvarchar(10))
--Insert into @publicHolidays (Holiday, Date, DayofWeek)
---- New Years Day
SET @Date=CONVERT( datetime, CONVERT(varchar, YEAR( @Year ) )+'-01-01' ) 
IF DATENAME( dw, @Date ) = 'Saturday'
    SET @Date=@Date-1
ELSE IF DATENAME( dw, @Date ) = 'Sunday'
    SET @Date=@Date+1
Insert into @publicHolidays (Holiday, Date, DayofWeek)
 SELECT 'New Years Day', @Date, DATENAME( dw, @Date ) 
--select * from @publicHolidays
---- Martin L King's Birthday ( 3rd Monday in January )
SET @Date = CONVERT( datetime, CONVERT(varchar, YEAR( @Year ) )+'-01-01' ) 
SET @Holiday = DATEADD( wk, DATEDIFF( wk, 0, dateadd( dd, 18-datepart( day, @Date ), @Date ) ), 0 ) -- 3rd Monday of the Month
Insert into @publicHolidays (holiday, Date, DayofWeek)
SELECT 'Martin L King''s Birthday', @Holiday, DATENAME( dw, @Holiday )

