---------------------------------------------------------
;WITH D AS
(
    SELECT DATEFROMPARTS(@Year,2,1) AS Dt
    UNION ALL
    SELECT DATEADD(DAY,1,Dt)
    FROM D
    WHERE MONTH(DATEADD(DAY,1,Dt)) = 2
)
INSERT INTO @PublicHolidays
SELECT TOP (1)
      'Presidents Day'
    , Dt
